# Optional. The web UI sends Jira/Azure credentials with each request,
# so these are only needed for the legacy GET endpoints (/jira/*, /azure/*,
# /sync/jira-to-azure/*) or for running without the UI.
# Copy to .env for local development — never commit .env.

# --- Jira ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# --- Azure DevOps ---
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_TEAM=
AZURE_DEVOPS_PAT=

# --- Assignee mapping (used by UI sync too) ---
# JSON map of Jira email -> Azure DevOps email, for people whose emails differ.
ASSIGNEE_EMAIL_OVERRIDES={"jira.address@example.com": "azure.address@example.com"}
